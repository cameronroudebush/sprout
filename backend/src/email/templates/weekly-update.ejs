<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      <%- include('styles.css') %>
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <img
          src="https://media.githubusercontent.com/media/cameronroudebush/sprout/master/frontend/assets/logo/color-transparent-no-tag.png"
          alt="Sprout Logo"
          class="logo"
        />
        <h1></h1>
      </div>
      <div class="content">
        <div class="hero" style="font-size: 16px"><%= locals.greeting %>, <%= locals.user %>. Here's your weekly finance update.</div>

        <!-- Weekly Summary Hero Card -->
        <div class="section">
          <div class="section-title">Weekly Summary</div>
          <div class="hero-stat-card">
            <div class="hero-stat-primary">
              <span class="label">Current Net Worth</span>
              <span class="value <%= locals.totalNetWorth > 0 ? 'income' : 'expense' %>"><%= locals.totalNetWorthText %></span>
            </div>
            
            <div class="hero-stat-divider"></div>
            
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="hero-stat-subtable">
              <tr>
                <td class="hero-stat-subcell" style="border-right: 1px solid #1d2127;">
                  <span class="label">Total Expenses</span>
                  <span class="value expense"><%= locals.weeklyExpenses %></span>
                </td>
                <td class="hero-stat-subcell">
                  <span class="label">Total Income</span>
                  <span class="value <%= locals.weeklyIncome > 0 ? 'income' : '' %>"><%= locals.weeklyIncomeText %></span>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <!-- Daily Spending Bar Chart -->
        <% if (locals.dailySpendingBars && locals.dailySpendingBars.length > 0) { %>
        <div class="section" style="margin-top: 1.5rem;">
          <div class="section-title">Daily Spending</div>
          <div class="chart-container">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="chart-table">
              <tr>
                <% locals.dailySpendingBars.forEach(function(bar) { %>
                <td class="chart-amount-cell" width="14%">
                  <span><%= bar.amountText %></span>
                </td>
                <% }); %>
              </tr>
              <tr>
                <% locals.dailySpendingBars.forEach(function(bar) { %>
                <td class="chart-bar-cell" width="14%">
                  <% if (bar.heightPercent > 0) { %>
                    <div class="chart-bar" style="height: <%= bar.heightPercent %>%;"></div>
                  <% } %>
                </td>
                <% }); %>
              </tr>
              <tr>
                <% locals.dailySpendingBars.forEach(function(bar) { %>
                <td class="chart-label"><%= bar.label %></td>
                <% }); %>
              </tr>
            </table>
          </div>
        </div>
        <% } %>

        <!-- Transactions Table -->
        <div class="section" style="margin-top: 1.5rem;">
            <div class="section-title">Transactions</div>
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="tx-table">
                <thead>
                <tr>
                    <th style="width: 36px; text-align: center;"></th>
                    <th style="text-align: left; padding-left: 0.25rem;">Description</th>
                    <th style="text-align: right; width: 85px; padding-right: 0.5rem;">Amount</th>
                </tr>
                </thead>
                <tbody>
                <% locals.transactions.forEach(function(tx) { %>
                <tr>
                    <!-- Merchant Icon -->
                    <td style="width: 36px; text-align: center; padding-left: 0.5rem;">
                      <% if (tx.iconUrl) { %>
                        <img src="<%= tx.iconUrl %>" alt="" width="28" height="28" style="border-radius: 50%; display: block; object-fit: cover; background-color: #1d2127; margin: 0 auto;" />
                      <% } else { %>
                        <div style="width: 28px; height: 28px; border-radius: 50%; background-color: #1d2127; color: #a0cafd; text-align: center; line-height: 28px; font-weight: bold; font-size: 12px; margin: 0 auto;">
                          <%= tx.description ? tx.description.charAt(0).toUpperCase() : '$' %>
                        </div>
                      <% } %>
                    </td>
                    <!-- Title & Category -->
                    <td class="table-description" style="text-align: left; padding-left: 0.25rem;">
                      <span class="title"><%= tx.description %></span>
                      <span class="category"><%= tx.category %></span>
                    </td>
                    <!-- Amount -->
                    <td style="text-align: right; white-space: nowrap; width: 85px; padding-right: 0.5rem;" class="amount <%= tx.amount < 0 ? 'expense' : 'income' %>"><%= tx.amountText %></td>
                </tr>
                <% }); %>
                </tbody>
            </table>
        </div>

        <div class="hero quote-hero"><%= locals.quote %></div>
        
        <div class="section footer">
            <p style="font-size: small">Generated on <%= locals.today %></p>
            <p style="font-size: small">Data start date: <%= locals.oneWeekAgoDate %></p>
            <p style="font-size: small;">Emailed, with love, by <a target="_blank" href="https://sprout.croudebush.net">Sprout</a></p>
        </div>
      </div>
    </div>
  </body>
</html>