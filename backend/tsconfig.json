{
  "extends": "./tsconfig.base.json",
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"],
    "paths": { "@backend/*": ["./src/*"] }
  },
  "include": ["./src/**/*"]
}
